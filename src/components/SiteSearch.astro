<div class="site-search" data-site-search>
  <form class="site-search__form" role="search" autocomplete="off">
    <span class="site-search__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
    </span>
    <label class="visually-hidden" for="site-search-input">사이트 검색</label>
    <input
      id="site-search-input"
      class="site-search__input"
      type="search"
      inputmode="search"
      placeholder="해설 검색"
      aria-controls="site-search-results"
      aria-expanded="false"
    />
    <button class="site-search__clear" type="button" aria-label="검색어 지우기" hidden>×</button>
  </form>

  <div
    id="site-search-results"
    class="site-search__panel"
    role="region"
    aria-label="검색 결과"
    hidden
  >
    <p class="site-search__status" aria-live="polite"></p>
    <ol class="site-search__results"></ol>
    <div class="site-search__sentinel" aria-hidden="true" hidden>
      <span class="site-search__spinner"></span>
      <span>결과 불러오는 중…</span>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll("[data-site-search]");

    for (const root of roots) {
      const form = root.querySelector(".site-search__form");
      const input = root.querySelector(".site-search__input");
      const clear = root.querySelector(".site-search__clear");
      const panel = root.querySelector(".site-search__panel");
      const status = root.querySelector(".site-search__status");
      const list = root.querySelector(".site-search__results");
      const sentinel = root.querySelector(".site-search__sentinel");

      if (!form || !input || !clear || !panel || !status || !list || !sentinel) continue;

      const PAGE_SIZE = 20;
      let pagefindPromise;
      let requestId = 0;
      let resultRefs = [];
      let loadedRefCount = 0;
      let renderedCount = 0;
      let loadingMore = false;

      const openPanel = () => {
        panel.hidden = false;
        input.setAttribute("aria-expanded", "true");
      };

      const closePanel = () => {
        panel.hidden = true;
        input.setAttribute("aria-expanded", "false");
      };

      const resetResults = () => {
        resultRefs = [];
        loadedRefCount = 0;
        renderedCount = 0;
        loadingMore = false;
        list.innerHTML = "";
        sentinel.hidden = true;
      };

      const loadPagefind = async () => {
        if (!pagefindPromise) {
          const bundlePath = "/pagefind/pagefind.js";
          pagefindPromise = import(/* @vite-ignore */ bundlePath).catch(() => null);
        }
        return pagefindPromise;
      };

      const escapeHtml = (value) =>
        String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const resultMarkup = (result) => {
        const title = escapeHtml(result.meta?.title || "제목 없음");
        const url = escapeHtml(result.url);
        const excerpt = result.excerpt || "";
        return `
          <li class="site-search__item">
            <a class="site-search__result" href="${url}">
              <strong>${title}</strong>
              <span>${excerpt}</span>
            </a>
          </li>`;
      };

      const updateStatus = () => {
        const total = resultRefs.length;
        if (!total) {
          status.textContent = "검색 결과가 없습니다.";
          return;
        }

        status.textContent = renderedCount < total
          ? `${total.toLocaleString("ko-KR")}개 결과 중 ${renderedCount.toLocaleString("ko-KR")}개 표시`
          : `${total.toLocaleString("ko-KR")}개 결과 모두 표시`;
      };

      const loadNextBatch = async (expectedRequestId = requestId) => {
        if (
          loadingMore ||
          expectedRequestId !== requestId ||
          loadedRefCount >= resultRefs.length
        ) return;

        loadingMore = true;
        sentinel.hidden = false;

        const start = loadedRefCount;
        const end = Math.min(start + PAGE_SIZE, resultRefs.length);
        const batch = resultRefs.slice(start, end);

        // 같은 배치를 중복 요청하지 않도록 데이터 로딩 전에 위치를 전진시킵니다.
        loadedRefCount = end;

        const settled = await Promise.allSettled(batch.map((result) => result.data()));
        if (expectedRequestId !== requestId) return;

        const loaded = settled
          .filter((item) => item.status === "fulfilled")
          .map((item) => item.value);

        if (loaded.length) {
          list.insertAdjacentHTML("beforeend", loaded.map(resultMarkup).join(""));
          renderedCount += loaded.length;
        }

        loadingMore = false;
        sentinel.hidden = loadedRefCount >= resultRefs.length;
        updateStatus();
      };

      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            void loadNextBatch(requestId);
          }
        },
        {
          root: panel,
          rootMargin: "0px 0px 180px 0px",
          threshold: 0.01,
        },
      );
      observer.observe(sentinel);

      // IntersectionObserver를 지원하지 않거나 레이아웃 변화로 감지가 늦는 경우를 위한 보조 처리입니다.
      panel.addEventListener("scroll", () => {
        const distanceToBottom = panel.scrollHeight - panel.scrollTop - panel.clientHeight;
        if (distanceToBottom < 180) void loadNextBatch(requestId);
      }, { passive: true });

      const search = async () => {
        const query = input.value.trim();
        clear.hidden = query.length === 0;
        const currentRequest = ++requestId;

        if (query.length < 2) {
          resetResults();
          status.textContent = query.length === 1 ? "두 글자 이상 입력해 주세요." : "";
          query.length === 1 ? openPanel() : closePanel();
          return;
        }

        openPanel();
        resetResults();
        status.textContent = "검색 중…";
        panel.scrollTop = 0;

        const pagefind = await loadPagefind();
        if (currentRequest !== requestId) return;

        if (!pagefind) {
          status.textContent = "검색 인덱스는 빌드 후 사용할 수 있습니다.";
          return;
        }

        const searchResult = await pagefind.debouncedSearch(query, {}, 180);
        if (!searchResult || currentRequest !== requestId) return;

        resultRefs = searchResult.results;
        if (!resultRefs.length) {
          updateStatus();
          return;
        }

        await loadNextBatch(currentRequest);
      };

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        list.querySelector("a")?.click();
      });

      input.addEventListener("input", search);
      input.addEventListener("focus", () => {
        if (input.value.trim()) search();
      });
      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closePanel();
          input.blur();
        }
      });

      clear.addEventListener("click", () => {
        requestId++;
        input.value = "";
        clear.hidden = true;
        resetResults();
        status.textContent = "";
        closePanel();
        input.focus();
      });

      document.addEventListener("pointerdown", (event) => {
        if (!root.contains(event.target)) closePanel();
      });
    }
  })();
</script>
